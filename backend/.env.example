# ─── Base de données ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/leadpulse"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Génère avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change_me_minimum_32_chars_long_random_string"

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Clé secrète depuis dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Depuis dashboard.stripe.com/webhooks (après création du webhook)
STRIPE_WEBHOOK_SECRET="whsec_..."
# IDs des prix depuis dashboard.stripe.com/products
STRIPE_PRICE_STARTER="price_..."   # 49€/mois
STRIPE_PRICE_PRO="price_..."       # 99€/mois

# ─── Hunter.io ───────────────────────────────────────────────────────────────
# Depuis hunter.io/api-keys
HUNTER_API_KEY="your_hunter_api_key"

# ─── Clearbit ────────────────────────────────────────────────────────────────
# Depuis dashboard.clearbit.com/api
CLEARBIT_API_KEY="your_clearbit_api_key"

# ─── Redis (BullMQ) ──────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT="3001"
FRONTEND_URL="http://localhost:5173"
